{
  "name": "moviewatchlist",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "cf:build": "pnpm --filter @moviewatchlist/web run cf:build",
    "cf:deploy": "pnpm --filter @moviewatchlist/web run cf:deploy",
    "cf:upload": "pnpm --filter @moviewatchlist/web run cf:upload",
    "react-doctor": "turbo react-doctor --continue",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "pnpm@10.33.2"
}
