# TMDB API — https://www.themoviedb.org/settings/api
# Server-only: the raw read access token, without a "Bearer " prefix.
TMDB_API_KEY="YOUR_TMDB_TOKEN"
NEXT_PUBLIC_API_URL="https://api.themoviedb.org/3"
NEXT_PUBLIC_API_IMAGE_PATH="https://image.tmdb.org/t/p/"

# Site
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Stripe — https://dashboard.stripe.com/test/apikeys
# Server-only. Use test-mode keys (sk_test_…) until the Worker is on Workers
# Paid: an unlimited premium shelf breaks past ~45 titles on the free plan
# (PLAN.md Phase 4 step 5). Leave unset to hide the Premium section.
# In production these are Worker secrets (`wrangler secret put`), not vars.
STRIPE_SECRET_KEY="sk_test_..."
# Price IDs for the Premium product's two recurring prices.
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_ANNUAL="price_..."

# Playwright end-to-end tests — a dedicated, already-confirmed account.
# Not NEXT_PUBLIC_: that prefix inlines a value into the client bundle.
# The suite writes real rows for this user, so do not use a personal account.
E2E_EMAIL="e2e@example.com"
E2E_PASSWORD="YOUR_TEST_PASSWORD"
