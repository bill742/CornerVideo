# Copy to apps/mobile/.env and fill in. Use the SAME Supabase project as
# apps/web/.env so accounts are shared.
#
# Expo inlines every EXPO_PUBLIC_ var into the shipped app bundle, where anyone
# can read it out of the binary. Nothing secret belongs in this file — that is
# why there is no TMDB token here: reads go through the web app's proxy, which
# holds the token server-side.

# TMDB proxy — the web app's /api/tmdb route. Must be http:// when pointing at
# `next dev`, which serves no TLS; an https:// URL there simply times out.
#
# `localhost` is resolved by whatever is running the app, not by your Mac, so
# the right host depends on where the app runs:
#
#   iOS simulator — shares the host's network stack, so localhost is the Mac:
#     http://localhost:3000/api/tmdb
#   Android emulator — a VM with its own network stack, so localhost is the
#   emulator itself and the connection is refused. Reach the host through the
#   emulator's alias for it (10.0.3.2 under Genymotion):
#     http://10.0.2.2:3000/api/tmdb
#   Physical device on the same Wi-Fi, and the one value that also works for
#   both of the above — the Mac's LAN address as printed by `next dev`:
#     http://192.168.1.20:3000/api/tmdb
#   Deployed:
#     https://YOUR_WEB_APP_DOMAIN/api/tmdb
#
# Expo inlines this at bundle time, so restart with `expo start -c` after
# changing it — editing the file alone does not reach a running app.
EXPO_PUBLIC_TMDB_PROXY_URL="http://localhost:3000/api/tmdb"
EXPO_PUBLIC_TMDB_IMAGE_PATH="https://image.tmdb.org/t/p/"

# Supabase — https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# RevenueCat — https://app.revenuecat.com → Project settings → API keys.
# These are the PUBLIC SDK keys (appl_…, goog_…, test_…), which are meant to
# ship in the app. The secret key (sk_…) only ever goes to Supabase secrets.
#
# Development builds use the Test Store key when it's set: purchases go
# through RevenueCat's Test Store with no App Store Connect or Play Console
# setup. Release builds always use the platform key — the SDK crashes a
# release build on purpose if it finds a Test Store key. Leave all three unset
# to hide the Premium section.
EXPO_PUBLIC_REVENUECAT_TEST_KEY="test_..."
EXPO_PUBLIC_REVENUECAT_IOS_KEY="appl_..."
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY="goog_..."
